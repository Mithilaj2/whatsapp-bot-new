# Production settings. deploy/setup.sh fills this in for you as .env.production (in the project
# folder). Keep that file private: it holds the keys to everything. Never paste it in a chat.

# --- Addresses
# The panel's address(es), comma-separated. Resellers' own domains are added in the panel.
PANEL_DOMAINS="app.webrand360.com"
# Public address of the API (WhatsApp downloads campaign images from it)
PUBLIC_API_URL="https://app.webrand360.com/api"
# Email for Let's Encrypt (certificate expiry warnings)
ACME_EMAIL="development@example.com"

# --- Secrets (generate each with: openssl rand -hex 32)
POSTGRES_PASSWORD=""
JWT_SECRET=""
# Encrypts WhatsApp tokens in the database. NEVER change it once numbers are saved.
ENCRYPTION_KEY=""
JWT_EXPIRES_IN="7d"

# --- First admin login (used once, by the seed step)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="We Brand 360"

# --- WhatsApp (Meta). From developers.facebook.com > your app
META_APP_ID=""
META_APP_SECRET=""
# Any long random string; type the same in Meta > WhatsApp > Configuration > Webhook
META_VERIFY_TOKEN=""
# System user token (Business settings > System users), never expires
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v23.0"

# --- Campaign limits
CAMPAIGN_DEMO_MAX=10
CAMPAIGN_MIN_RECIPIENTS=1000
CAMPAIGN_MAX_RECIPIENTS=100000
CAMPAIGN_BRANDED_MIN=11

# --- Bot Studio AI answers (optional). Key from console.anthropic.com; empty = AI off
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"
BOT_AI_DAILY_LIMIT=20
BOT_IDLE_MINUTES=30
BOT_HANDOFF_HOURS=24

# --- Dashboard, notifications, logs
APP_TIMEZONE="Asia/Kolkata"
LOW_CREDIT_THRESHOLD=100
NOTIFICATION_KEEP_DAYS=90
AUDIT_KEEP_DAYS=365
