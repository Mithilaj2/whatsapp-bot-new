# Web server in front of everything: HTTPS certificates (Let's Encrypt), compression, and
# routing /api to the API and the rest to the panel. Works for our domain and for every
# reseller's white-label domain: a certificate is only issued for domains the API approves.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:4000/api/public/branding/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 10MB
	}
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
	log {
		output stdout
		format console
	}
}

http:// {
	redir https://{host}{uri} permanent
}
