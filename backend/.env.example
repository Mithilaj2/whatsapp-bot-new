# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection
DATABASE_URL="postgresql://webrand:webrand@localhost:5432/webrand360?schema=public"

# Long random string used to sign login tokens (generate with: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# API server port
PORT=4000

# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGINS="http://localhost:3000"

# First platform admin, created by the seed script
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="We Brand 360"

# Key used to encrypt WhatsApp access tokens in the database (generate with: openssl rand -hex 32).
# Back it up: if it is lost, saved tokens must be entered again.
ENCRYPTION_KEY="change-me-generate-with-openssl"

# Public address of this API, used to show the webhook URL to paste into Meta
PUBLIC_API_URL="http://localhost:4000/api"

# Set to false on extra API servers if you run the sending worker separately
WORKER_ENABLED=true

# --- WhatsApp Cloud API (Meta) ---
# developers.facebook.com > your app > App settings > Basic
META_APP_ID=""
META_APP_SECRET=""
# Any long random string; paste the same value into Meta > WhatsApp > Configuration > Webhook
META_VERIFY_TOKEN=""
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management
META_ACCESS_TOKEN=""
META_GRAPH_VERSION="v23.0"
META_GRAPH_URL="https://graph.facebook.com"

# --- Campaigns ---
# Where uploaded campaign images are stored (WhatsApp downloads them from PUBLIC_API_URL/media/...)
UPLOAD_DIR="./uploads"
# Up to this many recipients counts as a demo; full campaigns need MIN to MAX recipients
CAMPAIGN_DEMO_MAX=10
CAMPAIGN_MIN_RECIPIENTS=1000
CAMPAIGN_MAX_RECIPIENTS=100000
# Branded campaigns go from the customer's own number, so smaller lists are allowed
CAMPAIGN_BRANDED_MIN=11

# Bot Studio
# AI answers for bots (Claude). Leave empty to switch AI off. Key from console.anthropic.com
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"
# AI answers per person per day, to keep costs in check
BOT_AI_DAILY_LIMIT=20
# A chat with no reply for this long starts fresh
BOT_IDLE_MINUTES=30
# After "Talk to a person", the bot stays quiet for this long (or until the chat is ended)
BOT_HANDOFF_HOURS=24
